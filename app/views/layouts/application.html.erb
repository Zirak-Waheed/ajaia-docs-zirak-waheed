<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ajaia Docs" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <%= link_to "Ajaia Docs", root_path, class: "brand" %>
      <% if authenticated? %>
        <div class="who">
          <span>Signed in as <strong><%= Current.user.email_address %></strong></span>
          <%= button_to "Sign out", session_path, method: :delete, class: "btn-link" %>
        </div>
      <% end %>
    </header>

    <main class="container">
      <% flash.each do |type, message| %>
        <div class="flash flash-<%= type %>"><%= message %></div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
