<% content_for :title, "#{@document.title} · Ajaia Docs" %>

<div class="editor-layout">
  <div class="editor-main">
    <%= form_with model: @document, class: "doc-form",
          data: { controller: "autosave", action: "trix-change->autosave#changed input->autosave#changed" } do |f| %>
      <% if @document.errors.any? %>
        <div class="flash flash-alert"><%= @document.errors.full_messages.to_sentence %></div>
      <% end %>

      <div class="doc-head">
        <%= f.text_field :title, class: "title-input", maxlength: 200, required: true, "aria-label": "Document title" %>
        <span class="save-status" data-autosave-target="status" aria-live="polite">All changes saved</span>
        <%= f.submit "Save", class: "btn" %>
      </div>

      <%= f.rich_text_area :body, placeholder: "Start writing…" %>
    <% end %>
  </div>

  <aside class="sidebar">
    <%= render "sharing", document: @document %>
  </aside>
</div>
